# Local first-party BiimSlideMaker checkout
.tools/BiimSlideMaker/

# Generated PDF/video artifacts
domains/*/video/generated/
domains/*/pdf/generated/
*.wav
*.mp3
*.mp4
*.mov
*.mkv

# Build-only publication packages
dist/**/pdf/
dist/**/video/
dist/offline/
dist/release/
dist/**/publication-manifest.json

