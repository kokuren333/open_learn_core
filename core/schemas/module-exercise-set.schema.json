{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-learn-core.example/schemas/module-exercise-set.schema.json",
  "title": "Open Learn Module Exercise Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "module", "title", "exercises"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "module": { "type": "string" },
    "title": { "$ref": "concept.schema.json#/$defs/localized" },
    "exercises": { "type": "array", "minItems": 1, "items": { "$ref": "learning-unit.schema.json#/$defs/exercise" } }
  }
}
