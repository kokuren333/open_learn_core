{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-learn-core.example/schemas/learning-block.schema.json",
  "title": "Open Learn Learning Block v2.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "purpose", "learner_state_before", "activity", "required_elements", "learner_state_after", "learning_outcome_ids", "external_prerequisite_concept_ids", "internal_block_dependencies", "difficulty", "expected_time_minutes", "generated_from"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "type": { "enum": ["hook", "concrete_problem", "learner_prediction", "guided_exploration", "failure_case", "contrast", "concept_emergence", "formalization", "worked_example", "guided_practice", "misconception_challenge", "independent_practice", "representation", "transfer", "synthesis"] },
    "purpose": { "type": "string", "minLength": 20 },
    "learner_state_before": { "type": "string", "minLength": 10 },
    "activity": { "type": "string", "minLength": 20 },
    "required_elements": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "learner_state_after": { "type": "string", "minLength": 10 },
    "learning_outcome_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "external_prerequisite_concept_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "internal_block_dependencies": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "difficulty": { "enum": ["basic", "standard", "challenge"] },
    "expected_time_minutes": { "type": "integer", "minimum": 1 },
    "generated_from": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "answer": { "type": "string", "minLength": 1 },
    "hint": { "type": "string", "minLength": 1 },
    "worked_example": { "$ref": "#/$defs/workedExample" },
    "misconception_challenge": { "$ref": "#/$defs/misconceptionChallenge" },
    "representation": { "type": "string", "minLength": 1 },
    "visual_ref": { "type": "string", "minLength": 1 },
    "takeaway": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "workedExample": { "type": "object", "additionalProperties": false, "required": ["problem", "learner_prediction", "reasoning_steps", "calculations", "interpretation", "conclusion", "generalizable_takeaway"], "properties": { "problem": { "type": "string", "minLength": 20 }, "learner_prediction": { "type": "string", "minLength": 10 }, "reasoning_steps": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 10 } }, "calculations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "interpretation": { "type": "string", "minLength": 20 }, "conclusion": { "type": "string", "minLength": 10 }, "generalizable_takeaway": { "type": "string", "minLength": 20 } } },
    "misconceptionChallenge": { "type": "object", "additionalProperties": false, "required": ["prompt", "expected_wrong_path", "correction", "explanation", "transfer_check"], "properties": { "prompt": { "type": "string", "minLength": 20 }, "expected_wrong_path": { "type": "string", "minLength": 10 }, "correction": { "type": "string", "minLength": 20 }, "explanation": { "type": "string", "minLength": 20 }, "transfer_check": { "type": "string", "minLength": 20 } } }
  }
}
