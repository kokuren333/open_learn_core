{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-learn-core.example/schemas/learning-unit.schema.json",
  "title": "Open Learn Learning Unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "module", "order", "title", "estimated_duration", "concepts", "prerequisites", "learning_objectives", "content", "exercises", "formats", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "module": { "type": "string" },
    "order": { "type": "integer" },
    "title": { "$ref": "concept.schema.json#/$defs/localized" },
    "summary": { "$ref": "concept.schema.json#/$defs/localized" },
    "estimated_duration": { "type": "object", "required": ["reading_minutes", "video_minutes"], "properties": { "reading_minutes": { "type": "number" }, "video_minutes": { "type": "number" } } },
    "concepts": { "type": "object", "required": ["primary", "supporting"], "properties": { "primary": { "type": "array", "items": { "type": "string" } }, "supporting": { "type": "array", "items": { "type": "string" } } } },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "learning_objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contentBlock" } },
    "exercises": { "type": "array", "items": { "$ref": "#/$defs/exercise" } },
    "formats": { "type": "object", "required": ["html", "pdf", "video"], "properties": { "html": { "$ref": "#/$defs/format" }, "pdf": { "$ref": "#/$defs/format" }, "video": { "$ref": "#/$defs/format" } } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "visuals": { "type": "array", "items": { "type": "string" } },
    "remediation": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["planned", "researched", "authored", "audited", "published"] }
  },
  "$defs": {
    "format": { "type": "object", "required": ["required", "status"], "properties": { "required": { "type": "boolean" }, "status": { "type": "string" } } },
    "contentBlock": { "type": "object", "required": ["type", "body"], "properties": { "type": { "type": "string" }, "body": { "type": "string", "minLength": 1 }, "claimRefs": { "type": "array", "items": { "type": "string" } }, "visual": { "type": "string" } } },
    "exercise": { "type": "object", "required": ["id", "type", "question", "solution"], "properties": { "id": { "type": "string" }, "type": { "type": "string" }, "question": { "type": "string", "minLength": 1 }, "solution": { "$ref": "#/$defs/solution" }, "difficulty": { "type": "string" } } },
    "solution": { "type": "object", "required": ["what_is_asked", "concepts", "strategy", "steps", "why", "conclusion", "common_wrong_path"], "properties": { "what_is_asked": { "type": "string" }, "concepts": { "type": "array", "items": { "type": "string" } }, "strategy": { "type": "string" }, "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "why": { "type": "array", "items": { "type": "string" } }, "conclusion": { "type": "string" }, "common_wrong_path": { "type": "string" }, "alternative": { "type": "string" } } }
  }
}
