{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-learn-core.example/schemas/domain-manifest.schema.json",
  "title": "Open Learn Domain Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "version", "status", "language", "level", "entry_curriculum", "entry_concepts", "core_compatibility", "content_root", "asset_root", "publish"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "$ref": "concept.schema.json#/$defs/localized" },
    "description": { "$ref": "concept.schema.json#/$defs/localized" },
    "version": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["experimental", "stable", "archived"] },
    "language": { "type": "object", "additionalProperties": false, "required": ["default", "supported"], "properties": { "default": { "type": "string", "minLength": 2 }, "supported": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "level": { "type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": { "min": { "type": "string" }, "max": { "type": "string" } } },
    "entry_curriculum": { "type": "array", "items": { "type": "string" } },
    "entry_concepts": { "type": "array", "items": { "type": "string" } },
    "quality_gate_concepts": { "type": "array", "items": { "type": "string" } },
    "core_compatibility": { "type": "object", "additionalProperties": false, "required": ["min_version"], "properties": { "min_version": { "type": "string" } } },
    "content_root": { "type": "string", "minLength": 1 },
    "asset_root": { "type": "string", "minLength": 1 },
    "publish": { "type": "object", "additionalProperties": false, "required": ["enabled", "path"], "properties": { "enabled": { "type": "boolean" }, "path": { "type": "string", "minLength": 1 } } }
  }
}
