{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-learn-core.example/schemas/core-concept.schema.json",
  "title": "Open Learn Core Concept v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "central_mental_model", "cognitive_types", "cognitive_profile", "facets", "procedures", "properties", "representations", "misconceptions", "applications", "external_relations", "learning_contract", "pedagogical_plan", "editorial_status", "source_concept_ids", "prerequisites"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "$ref": "concept.schema.json#/$defs/localized" },
    "central_mental_model": { "type": "string", "minLength": 30 },
    "cognitive_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["concrete_object", "structural_definition", "abstraction", "procedure", "transformation_process", "invariant_quantity", "relationship_theorem", "representation", "optimization_approximation"] } },
    "cognitive_profile": { "$ref": "#/$defs/profile" },
    "facets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/namedItem" } },
    "procedures": { "type": "array", "items": { "$ref": "#/$defs/namedItem" } },
    "properties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "representations": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/namedItem" } },
    "misconceptions": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
    "applications": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "external_relations": { "type": "array", "items": { "$ref": "#/$defs/externalRelation" } },
    "learning_contract": { "$ref": "#/$defs/learningContract" },
    "pedagogical_plan": { "$ref": "#/$defs/pedagogicalPlan" },
    "editorial_status": { "enum": ["scaffold", "draft", "reviewed", "gold"] },
    "source_concept_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "prerequisites": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "related": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "profile": { "type": "object", "additionalProperties": false, "required": ["abstraction", "procedural", "visual", "prerequisite_load", "misconception_risk", "representation_switching", "symbolic_density"], "properties": { "abstraction": { "$ref": "#/$defs/score" }, "procedural": { "$ref": "#/$defs/score" }, "visual": { "$ref": "#/$defs/score" }, "prerequisite_load": { "$ref": "#/$defs/score" }, "misconception_risk": { "$ref": "#/$defs/score" }, "representation_switching": { "$ref": "#/$defs/score" }, "symbolic_density": { "$ref": "#/$defs/score" } } },
    "score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "namedItem": { "type": "object", "additionalProperties": false, "required": ["id", "title", "description"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "title": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } } },
    "externalRelation": { "type": "object", "additionalProperties": false, "required": ["domain", "concept", "relation"], "properties": { "domain": { "type": "string", "minLength": 1 }, "concept": { "type": "string", "minLength": 1 }, "relation": { "enum": ["requires", "extends", "applied_in", "analogous_to", "special_case_of", "generalized_by"] } } },
    "learningContract": { "type": "object", "additionalProperties": false, "required": ["learner_should_be_able_to", "must_not_leave_with_misconceptions", "required_representations", "required_examples", "required_learning_elements"], "properties": { "learner_should_be_able_to": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } }, "must_not_leave_with_misconceptions": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } }, "required_representations": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }, "required_examples": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }, "required_learning_elements": { "$ref": "#/$defs/learningElements" } } },
    "learningElements": { "type": "object", "additionalProperties": false, "required": ["motivating_problem", "intuition", "formalization", "positive_examples", "contrasting_nonexamples", "worked_examples", "learner_predictions", "misconceptions", "practice", "synthesis"], "properties": { "motivating_problem": { "type": "integer", "minimum": 1 }, "intuition": { "type": "integer", "minimum": 1 }, "formalization": { "type": "integer", "minimum": 1 }, "positive_examples": { "type": "integer", "minimum": 1 }, "contrasting_nonexamples": { "type": "integer", "minimum": 1 }, "worked_examples": { "type": "integer", "minimum": 1 }, "learner_predictions": { "type": "integer", "minimum": 1 }, "misconceptions": { "type": "integer", "minimum": 1 }, "practice": { "$ref": "#/$defs/practice" }, "synthesis": { "type": "integer", "minimum": 1 } } },
    "practice": { "type": "object", "additionalProperties": false, "required": ["basic", "conceptual", "transfer"], "properties": { "basic": { "type": "integer", "minimum": 1 }, "conceptual": { "type": "integer", "minimum": 1 }, "transfer": { "type": "integer", "minimum": 1 } } },
    "pedagogicalPlan": { "type": "object", "additionalProperties": false, "required": ["pattern", "reason", "stages", "profile_driven_requirements"], "properties": { "pattern": { "enum": ["concrete_object", "structural_definition", "abstraction", "procedure", "transformation_process", "invariant_quantity", "relationship_theorem", "representation", "optimization_approximation"] }, "reason": { "type": "string", "minLength": 20 }, "stages": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } }, "profile_driven_requirements": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } } } }
  }
}
