{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-learn-core.example/schemas/module.schema.json",
  "title": "Open Learn Module",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "course", "order", "title", "description", "topics", "units", "purpose", "entry_prerequisites", "learning_objectives", "exit_competencies", "adjacent_modules", "exercise_ids"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "course": { "type": "string" },
    "order": { "type": "integer" },
    "title": { "$ref": "concept.schema.json#/$defs/localized" },
    "description": { "$ref": "concept.schema.json#/$defs/localized" },
    "purpose": { "$ref": "concept.schema.json#/$defs/localized" },
    "entry_prerequisites": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "learning_objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "exit_competencies": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "adjacent_modules": { "type": "object", "required": ["previous", "next"], "properties": { "previous": { "type": "string" }, "next": { "type": "string" } } },
    "topics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "units": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "exercise_ids": { "type": "array", "items": { "type": "string" } }
  }
}
