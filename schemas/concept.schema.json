{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-learn-core.example/schemas/concept.schema.json",
  "title": "Concept v1.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "prerequisites", "related", "learningObjectives", "lessons", "claims", "examples", "exercises", "misconceptions", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "$ref": "#/$defs/localized" },
    "summary": { "$ref": "#/$defs/localized" },
    "prerequisites": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "related": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "learningObjectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "lessons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lesson" } },
    "claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "content": { "type": "object", "required": ["explanation"], "additionalProperties": false, "properties": { "explanation": { "type": "string", "minLength": 1 } } },
    "examples": { "type": "array", "items": { "$ref": "#/$defs/example" } },
    "exercises": { "type": "array", "items": { "$ref": "#/$defs/exercise" } },
    "diagnosticQuestions": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "misconceptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "localized": { "type": "object", "required": ["ja", "en"], "additionalProperties": false, "properties": { "ja": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } } },
    "lesson": { "type": "object", "additionalProperties": false, "required": ["id", "title", "summary", "objectives", "sections", "exerciseIds"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "title": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 }, "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }, "exerciseIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } },
    "section": { "type": "object", "additionalProperties": false, "required": ["id", "title", "kind", "body"], "properties": { "id": { "type": "string" }, "title": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "enum": ["intuition", "definition", "why", "relationship", "method", "example", "counterexample", "summary"] }, "body": { "type": "string", "minLength": 1 }, "claimRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } },
    "claim": { "type": "object", "additionalProperties": false, "required": ["id", "statement", "sourceRefs"], "properties": { "id": { "type": "string" }, "statement": { "type": "string", "minLength": 1 }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } } } },
    "sourceRef": { "type": "object", "additionalProperties": false, "required": ["source", "locator"], "properties": { "source": { "type": "string" }, "locator": { "type": "string", "minLength": 1 } } },
    "example": { "type": "object", "additionalProperties": false, "required": ["id", "statement", "explanation"], "properties": { "id": { "type": "string" }, "statement": { "type": "string", "minLength": 1 }, "explanation": { "type": "string", "minLength": 1 } } },
    "exercise": { "type": "object", "additionalProperties": false, "required": ["id", "type", "difficulty", "question", "answer", "explanation"], "properties": { "id": { "type": "string" }, "type": { "type": "string" }, "difficulty": { "type": "string", "enum": ["basic", "standard", "challenge"] }, "question": { "type": "string", "minLength": 1 }, "answer": { "type": "string", "minLength": 1 }, "explanation": { "type": "string", "minLength": 1 }, "lessonId": { "type": "string" }, "skill": { "type": "string" } } },
    "diagnostic": { "type": "object", "additionalProperties": false, "required": ["id", "question", "answer", "explanation"], "properties": { "id": { "type": "string" }, "question": { "type": "string", "minLength": 1 }, "answer": { "type": "string", "minLength": 1 }, "explanation": { "type": "string", "minLength": 1 } } }
  }
}
