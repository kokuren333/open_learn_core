{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-learn-core.example/schemas/curriculum.schema.json",
  "title": "Curriculum",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "sequence"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "$ref": "concept.schema.json#/$defs/localized" },
    "description": { "type": "string", "minLength": 1 },
    "sequence": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
  }
}
