{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "locator", "evidence_role", "supports", "extracted_meaning", "confidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "source": { "type": "string" },
    "locator": { "type": "object", "additionalProperties": false, "required": ["type", "value", "section"], "properties": { "type": { "type": "string" }, "value": { "type": "string", "minLength": 1 }, "section": { "type": "string", "minLength": 1 } } },
    "evidence_role": { "type": "string", "enum": ["definition", "theorem", "example", "prerequisite", "curriculum", "interpretation"] },
    "supports": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "extracted_meaning": { "type": "object", "required": ["ja"], "additionalProperties": false, "properties": { "ja": { "type": "string", "minLength": 1 }, "en": { "type": "string" } } },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "notes": { "type": "object", "additionalProperties": false, "properties": { "ja": { "type": "string" }, "en": { "type": "string" } } }
  }
}
